		annotation SummarizationSetBy = Automatic

	partition DimProyectoConcurso = m
		mode: import
		source =
				let
				    Activities = VENTAS_activities_docs_activities,
																																												    Selected = Table.SelectColumns(
																																												        Activities,
																																												        {
																																												            "created_at",
																																												            "object_id",
																																												            "object_display_name",
																																												            "object_object_type",
																																												            "object_parent_folder_urn",
																																												            "object_folder_display_name",
																																												            "object_folder_id",
																																												            "object_version_urn"
																																												        },
																																												        MissingField.UseNull
																																												    ),
																																												    AsText = Table.TransformColumns(
																																												        Selected,
																																												        {
																																												            {"object_id", each if _ = null then null else Text.From(_), type nullable text},
																																												            {"object_display_name", each if _ = null then null else Text.From(_), type nullable text},
																																												            {"object_object_type", each if _ = null then null else Text.From(_), type nullable text},
																																												            {"object_parent_folder_urn", each if _ = null then null else Text.From(_), type nullable text},
																																												            {"object_folder_display_name", each if _ = null then null else Text.From(_), type nullable text},
																																												            {"object_folder_id", each if _ = null then null else Text.From(_), type nullable text},
																																												            {"object_version_urn", each if _ = null then null else Text.From(_), type nullable text}
																																												        }
																																												    ),
																																												    WithDate = Table.TransformColumns(
																																												        AsText,
																																												        {{"created_at", each try DateTime.From(_) otherwise null, type nullable datetime}}
																																												    ),
																																												    FolderRows0 = Table.SelectRows(
																																												        WithDate,
																																												        each [object_id] <> null
																																												            and [object_object_type] <> null
																																												            and Text.Contains(Text.Lower([object_object_type]), "folder")
																																												    ),
																																												    FolderRows1 = Table.AddColumn(
																																												        FolderRows0,
																																												        "FolderName",
																																												        each if [object_display_name] <> null then [object_display_name] else [object_folder_display_name],
																																												        type nullable text
																																												    ),
																																												    FolderRows2 = Table.RenameColumns(
																																												        Table.SelectColumns(FolderRows1, {"object_id", "object_parent_folder_urn", "FolderName", "created_at"}),
																																												        {{"object_id", "FolderKey"}, {"object_parent_folder_urn", "ParentKey"}}
																																												    ),
																																												    FolderRows3 = Table.Sort(FolderRows2, {{"created_at", Order.Descending}}),
																																												    Folders = Table.Buffer(Table.Distinct(FolderRows3, {"FolderKey"})),
