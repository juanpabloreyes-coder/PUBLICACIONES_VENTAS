				                                {"urn:adsk.wipprod:fs.folder:co.Z0V5hSpSSEWD7-htQ3xDZQ", "GAP_SJC"},
				                                {"urn:adsk.wipprod:fs.folder:co.Z4h98Ul2TMmNXKshoOUGIg", "GRANJAS JESSY"},
				                                {"urn:adsk.wipprod:fs.folder:co.z6C10neGT2OE6h-Bc4gR9Q", "GOHSYU"},
				                                {"urn:adsk.wipprod:fs.folder:co.Z6qVsKXNQheIpW71ovHCQg", "TUNGALOY"},
				                                {"urn:adsk.wipprod:fs.folder:co.zAagjoNORbq3AreX0tm4aQ", "BMW_ADECUACION"},
				                                {"urn:adsk.wipprod:fs.folder:co.zd1OLenbQcSO8X7f4dvi-Q", "GAP_SJC_NORTE"},
				                                {"urn:adsk.wipprod:fs.folder:co.zFDzFdhkSeSvI-ReM_7N4A", "GRANJAS JESSY"},
				                                {"urn:adsk.wipprod:fs.folder:co.Zg6U2j-8T3WgC7g43sNGvw", "GAP_SJC_NORTE"},
				                                {"urn:adsk.wipprod:fs.folder:co.ZG8zjKv_R1yuoHI7iaJyYA", "TUNGALOY"},
				                                {"urn:adsk.wipprod:fs.folder:co.ZH1rEu3YQfuA1FykLZhOVw", "BMW_ADECUACION"},
				                                {"urn:adsk.wipprod:fs.folder:co.ZHRtjwtZTBG1ryO_UbQctA", "GRANJAS JESSY"},
				                                {"urn:adsk.wipprod:fs.folder:co.ZJSf4Ek7R6WZ7aFTs3bq5g", "GONVAUTO F2"},
				                                {"urn:adsk.wipprod:fs.folder:co.zlEGmpo5TBSHeJN9oe_f9g", "BMW_ADECUACION"},
				                                {"urn:adsk.wipprod:fs.folder:co.zmwlFxUUS9OdauUc28Z8kg", "TUNGALOY"},
				                                {"urn:adsk.wipprod:fs.folder:co.zQr3Zd3zQW6R-1doW4GbwA", "GONVAUTO F2"},
				                                {"urn:adsk.wipprod:fs.folder:co.zvQDLpkSTqO--DLgjf1_TQ", "BMW_ADECUACION"},
				                                {"urn:adsk.wipprod:fs.folder:co.zWFCyzy9TYCaKtgzEGxhvQ", "GRANJAS JESSY"},
				                                {"urn:adsk.wipprod:fs.folder:co.ZWu8YLSgSFKKmNuSDA5eHA", "GAP_SJC_NORTE"},
				                                {"urn:adsk.wipprod:fs.folder:co.zxeibfOhTKS7Yop_rli6JQ", "GAP_SJC"},
				                                {"urn:adsk.wipprod:fs.folder:coY-vy63R0exVLLZimCODg", "GRANJAS JESSY"}
								            }
								        )
								    ),
																																												    SystemRoots = {"project files", "plans", "archivos de proyecto"},
																																												    ResolveRoot = (folderKey as nullable text, fallback as nullable text) as nullable text =>
																																												        let
																																												            Walk = (current as nullable text, candidate as nullable text, visited as list) as nullable text =>
																																												                let
																																												                    Rows = if current = null then #table({}, {}) else Table.SelectRows(Folders, each [FolderKey] = current),
																																												                    Found = not Table.IsEmpty(Rows),
																																												                    CurrentName = if Found then Rows{0}[FolderName] else null,
																																												                    Parent = if Found then Rows{0}[ParentKey] else null,
																																												                    CleanName = if CurrentName = null then null else Text.Trim(CurrentName),
																																												                    Candidate2 = if CleanName = null or List.Contains(SystemRoots, Text.Lower(CleanName)) then candidate else CleanName,
																																												                    Stop = not Found or Parent = null or List.Contains(visited, Parent),
																																												                    Result = if Stop then Candidate2 else @Walk(Parent, Candidate2, List.Combine({visited, {current}}))
																																												                in
																																												                    Result
																																												        in
																																												            Walk(folderKey, fallback, {}),
																																												    ResolveProject = (folderKey as nullable text, fallback as nullable text) as nullable text =>
																																												        let
																																												            LocalRows = if folderKey = null then #table({}, {}) else Table.SelectRows(LocalFolderMap, each [FolderKey] = folderKey),
																																												            LocalProject = if Table.IsEmpty(LocalRows) then null else LocalRows{0}[ProyectoConcursoLocal],
																																												            ActivityProject = ResolveRoot(folderKey, null),
																																												            Result = if LocalProject <> null then LocalProject else if ActivityProject <> null then ActivityProject else fallback
																																												        in
																																												            Result,
				
																																												    FileRows0 = Table.SelectRows(
																																												        WithDate,
																																												        each not (
																																												            [object_object_type] <> null
																																												            and Text.Contains(Text.Lower([object_object_type]), "folder")
																																												        )
																																												    ),
																																												    FileRows1 = Table.AddColumn(
																																												        FileRows0,
																																												        "DocumentKeys",
																																												        each List.Distinct(List.RemoveNulls({[object_version_urn], [object_id]})),
																																												        type list
																																												    ),
																																												    FileRows2 = Table.SelectRows(FileRows1, each List.Count([DocumentKeys]) > 0),
																																												    FileRows3 = Table.ExpandListColumn(FileRows2, "DocumentKeys"),
																																												    WithProject = Table.AddColumn(
																																												        FileRows3,
																																												        "ProyectoConcurso",
																																												        each ResolveProject(
																																												            if [object_parent_folder_urn] <> null then [object_parent_folder_urn] else [object_folder_id],
																																												            [object_folder_display_name]
																																												        ),
																																												        type nullable text
																																												    ),
																																												    WithStatus = Table.AddColumn(
																																												        WithProject,
																																												        "EstadoResolucion",
																																												        each
																																												            let
																																												                FolderKey = if [object_parent_folder_urn] <> null then [object_parent_folder_urn] else [object_folder_id],
																																												                LocalKnown = FolderKey <> null and not Table.IsEmpty(Table.SelectRows(LocalFolderMap, (r) => r[FolderKey] = FolderKey)),
																																												                ParentKnown = FolderKey <> null and not Table.IsEmpty(Table.SelectRows(Folders, (r) => r[FolderKey] = FolderKey))
																																												            in
																																												                if [ProyectoConcurso] = null then "Sin carpeta identificada"
																																												                else if LocalKnown then "Proyecto de primer nivel"
																																												                else if ParentKnown then "Jerarquia reconstruida"
																																												                else "Carpeta inmediata",
																																												        type text
																																												    ),
																																																						    Output0 = Table.RenameColumns(
																																																						        Table.SelectColumns(WithStatus, {"DocumentKeys", "object_display_name", "ProyectoConcurso", "EstadoResolucion", "created_at"}),
																																																						        {{"DocumentKeys", "linked_document_urn"}, {"object_display_name", "NombreArchivo"}, {"created_at", "UltimaActividad"}}
																																												    ),
																																												    Output1 = Table.SelectRows(Output0, each [linked_document_urn] <> null),
																																												    Output2 = Table.Sort(Output1, {{"UltimaActividad", Order.Descending}}),
																																												    Output = Table.Distinct(Output2, {"linked_document_urn"})
																																												in
																																												    Output

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

