<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Igual que revit_addin_sync/ (SheetSync) en PLANOS_VENTAS: net8.0 para Revit 2025. Si hay
         usuarios en Revit 2022-2024, compila una segunda vez con net48 y esas referencias. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>RevitSyncLogger</AssemblyName>
    <RootNamespace>PublicacionesVentas.RevitSyncLogger</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ajusta esta ruta a donde tenga instalado Revit cada maquina de compilacion. -->
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
